{
  "name": "kiln",
  "version": "3.11.3",
  "description": "kiln — 窑。中文后台设计系统，两层：工作台（紧凑、暖黑阴影分层）与纸面（大留白、印刷质感），同一套陶土釉色。",
  "type": "module",
  "scripts": {
    "test": "node scripts/test-runtime-contract.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:examples": "node scripts/verify-examples.mjs",
    "verify:paper": "node scripts/verify-paper.mjs"
  },
  "exports": {
