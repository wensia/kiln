    "./tokens/*": "./tokens/*",
    "./contract/runtime": "./scripts/lib/runtime-contract.mjs"
  },
  "files": [
    "tokens",
    "references",
    "SKILL.md",
    "ADOPTING.md",
    "contract",
    "evals",
    "examples",
    "scripts/lib",
    "scripts/templates"
  ],
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
